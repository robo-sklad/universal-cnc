# RedotPay Connect — переменные окружения для серверных функций api/redotpay/*.
# Значения задаются в Vercel: Project Settings → Environment Variables. Не храните ключи в репозитории.
REDOTPAY_APP_KEY=
# Приватный ключ RSA (PKCS#8 PEM). Можно одной строкой с \n вместо переводов строк.
REDOTPAY_PRIVATE_KEY=
# Номер загруженного в кабинет RedotPay публичного ключа (X-R-KEY-VERSION), обычно 1
REDOTPAY_API_VERSION=1
# Live: https://acquirer.redotpay.com   Sandbox: https://acquirersandbox.rp-2023app.com
REDOTPAY_BASE_URL=https://acquirer.redotpay.com
# Адрес сайта для возврата покупателя после оплаты
SITE_URL=https://xn----8sbmwfvpo8a.xn--p1ai
# Необязательно
REDOTPAY_CURRENCIES=USD
REDOTPAY_MAX_AMOUNT=50000
REDOTPAY_MERCHANT_NAME=
REDOTPAY_ALLOWED_ORIGINS=
# Рекомендуется для точной проверки подписи вебхуков (сырое тело запроса)
NODEJS_HELPERS=0
