@charset "utf-8";

html { height: 100%; }

body { height: 100%; margin: 0px; overflow-wrap: break-word; }

.bootstrapMenu span, .bootstrapMenu a { cursor: default; }

#separ { position: absolute; z-index: 30; cursor: col-resize; padding: 5px; top: 0px; height: 100%; }

#cover { position: absolute; z-index: 40; display: none; top: 0px; left: 0px; width: 100%; height: 100%; }

#view { height: 100%; width: 100%; min-width: 800px; display: flex; flex-direction: row; }

#sidebar { color: white; text-align: center; background-color: rgb(51, 51, 51); display: flex; height: 100%; flex: 0 0 200px; flex-direction: column; z-index: 10; }

.header { font-size: 13px; margin-top: 10px; margin-bottom: 2px; color: rgb(221, 221, 221); flex: 0 0 auto; }

#textViewButtons, #treeViewButtons, #aboutButtons { padding: 8px; flex: 0 0 auto; }

#leftbottomabs { position: absolute; bottom: 6px; left: 0px; width: 200px; height: 200px; background-color: rgb(51, 51, 51); z-index: 20; }

.bottomSeparator { flex-grow: 1; }

#sidebarbottom { background-color: rgb(51, 51, 51); width: 200px; flex: 0 0 200px; }

#rightsidebar { background-color: rgb(51, 51, 51); flex: 0 0 0px; }

#content { height: 100%; flex: 1 1 auto; cursor: default; overflow: auto; display: flex; flex-direction: row; }

#livePreview { width: 50%; cursor: default; display: flex; flex-direction: column; }

#textViewFull { flex: 1 1 0%; display: flex; color: black; font: 13px "Lucida Console", Monaco, monospace; }

#textView { width: 50%; color: black; font: 13px "Lucida Console", Monaco, monospace; }

#liveFrame { height: 100%; width: 100%; }

pre { padding: 0px; border: 0px; }

.hljs { padding: 0px; }

code { cursor: text; }

textarea { flex: 1 1 0%; resize: none; }

.separator { height: 8px; }

.fa-fw { vertical-align: -1px; }

.btn-sm { padding: 5px 10px 4px; }

#treeView { margin: 9px 9px 50vh; font: 11px arial; color: black; height: max-content; width: 100%; }

.btn.focus, .btn.active.focus { outline: none; background-color: rgb(230, 230, 230); border-color: rgb(173, 173, 173); }

.img { display: inline-block; width: 15px; height: 19px; vertical-align: middle; background-image: url("images.png"); }

.space { background: none; }

.value { background-position: 0px 0px; }

.array { background-position: -60px 0px; }

.object { background-position: -75px 0px; }

.nodeExpandRoot { background-position: -150px 0px; }

.nodeExpand { background-position: -165px 0px; }

.nodeExpandEnd { background-position: -180px 0px; }

.nodeCollapseRoot { background-position: -195px 0px; }

.nodeCollapse { background-position: -210px 0px; }

.nodeCollapseEnd { background-position: -225px 0px; }

.node { background-position: -120px 0px; }

.nodeRoot { background-position: -90px 0px; }

.nodeLine { background-position: -105px 0px; }

.nodeEnd { background-position: -135px 0px; }

.stringValue { background-position: -45px 0px; }

.numberValue { background-position: -30px 0px; }

.booleanValue { background-position: -15px 0px; }

.nullValue { background-position: 0px 0px; }

.selectedRow { background-color: rgb(217, 233, 249); outline: rgb(158, 187, 216) solid 1px; }

.highlightedRow { background-color: rgb(217, 233, 249); }

#errorMessage { color: white; }

#sidebar .btn { text-align: left; padding-left: 20px; }

button.btn { cursor: default; }

.btn-default { color: rgb(17, 17, 17); background-color: rgb(221, 221, 221); }

.btn-default:hover { background-color: white; }

.smallIndentLeft { padding-left: 2px; cursor: text; vertical-align: middle; }

.copyrightText { padding-top: 8px; font-size: 12px; font-family: Arial; color: rgb(221, 221, 221); }

#editor { width: 100%; height: 100%; }

#editableDiv { cursor: text; overflow-wrap: break-word; word-break: break-all; width: 100%; height: 100%; padding: 3px; outline: none; }

.mainPage { background-color: rgb(51, 51, 51); height: 50%; display: flex; align-items: center; justify-content: center; }

.mainButton { width: 200px; }

.highlightedCode { white-space: pre-wrap; overflow-wrap: break-word; }

.linkColor, a.linkColor:hover, a.linkColor:visited, a.linkColor:active, a.linkColor:link, #copyrightName { color: rgb(221, 221, 221); }
