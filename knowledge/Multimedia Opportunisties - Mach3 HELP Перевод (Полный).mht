@charset "utf-8";

* { margin: 0px; padding: 0px; }

body { background: url("/assets/templates/prochor_tpl/images/fon.jpg"); font-family: Conv_Taurus, sans-serif; font-size: 14px; color: rgb(71, 72, 74); }

h1 { font-family: Conv_DINCondensedC, sans-serif; color: rgb(109, 110, 113); font-size: 26px; }

b, strong { color: rgb(109, 110, 113); font-size: 14px; }

p { color: rgb(109, 110, 113); font-size: 14px; padding-bottom: 13px; }

ul { list-style: outside none none; padding-left: 15px; }

li { list-style-image: url("/assets/templates/prochor_tpl/images/vl.png"); }

#trifler, #gordi { margin: 2px auto; width: 1200px; }

#gordi { width: 712px; }

.header { height: 105px; }

.footer { padding-top: 15px; height: 34px; }

.center { overflow: hidden; }

.content, .left, .right { float: left; margin-bottom: -32767px; padding-bottom: 32767px; text-align: left; }

.content { width: 570px; min-height: 600px; padding-left: 15px; padding-right: 13px; padding-top: 36px; }

.left { background: url("/assets/templates/prochor_tpl/images/vl.png") right top repeat-y; padding-top: 24px; width: 285px; }

.right { background: url("/assets/templates/prochor_tpl/images/vl.png") left top repeat-y; padding-left: 10px; padding-top: 24px; width: 285px; }

.clear { clear: both; }

#topmenu { padding-left: 315px; padding-right: 10px; padding-top: 98px; }

#leftmenu { background: url("/assets/templates/prochor_tpl/images/gll.png") right top repeat-x; text-align: right; padding: 10px 5px 12px 0px; }

#z-content { background: url("/assets/templates/prochor_tpl/images/gll.png") left bottom repeat-x; font-family: Conv_DINCondensedC, sans-serif; color: rgb(109, 110, 113); font-size: 34px; text-decoration: none; text-align: left; padding: 5px 0px 10px 16px; margin-bottom: 12px; }

.left b { font-family: Conv_DINCondensedC, sans-serif; color: rgb(109, 110, 113); font-size: 26px; }

.left pre { font-family: Conv_DINCondensedC, sans-serif; color: rgb(109, 110, 113); font-size: 18px; }

#logo { padding-left: 63px; padding-top: 25px; position: absolute; }

#leftbox1, leftbox1 p { background: url("/assets/templates/prochor_tpl/images/gll.png") right top repeat-x; color: rgb(109, 110, 113); text-align: right; padding: 10px 18px 10px 0px; }

#rightbox1 { background: url("/assets/templates/prochor_tpl/images/gll.png") left top repeat-x; text-align: left; padding: 10px 18px 10px 0px; }

#rightmenu { background: url("/assets/templates/prochor_tpl/images/gll.png") left top repeat-x; text-decoration: none; padding: 10px 18px 10px 0px; }

.right b { font-family: Conv_DINCondensedC, sans-serif; color: rgb(109, 110, 113); font-size: 26px; }

#podrobnee { float: right; }

#podrobnee a { font-family: Conv_DINCondensedC, sans-serif; color: rgb(109, 110, 113); font-size: 18px; text-decoration: none; }

#podrobnee a:hover, #podrobnee a:active { font-family: Conv_DINCondensedC, sans-serif; color: rgb(71, 72, 74); font-size: 18px; text-decoration: none; }

#podrobnee a.active { color: rgb(255, 0, 204); text-decoration: none; }

#line_box { width: 280px; float: left; padding-bottom: 10px; }

#line_box_end { width: 280px; float: left; padding-bottom: 10px; }

.pagination a { text-decoration: none; color: rgb(109, 110, 113); border: 0px solid rgb(111, 123, 26); padding: 2px 5px; margin: 1px; }

.pagination a:hover { text-decoration: underline; }

.pagination .ditto_currentpage { color: rgb(0, 0, 0); background: rgb(255, 0, 204); border: 0px solid rgb(111, 123, 26); padding: 2px 5px; margin: 1px; }

.pagination .ditto_previous_link, .pagination .ditto_next_link { color: rgb(109, 110, 113); border: 0px solid rgb(111, 123, 26); padding: 2px 5px; margin: 1px; }

.pagination .ditto_page { padding: 2px 5px; }
